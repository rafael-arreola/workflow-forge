  "entry": "normalize",
  "nodes": [
    {
      "id": "normalize", "kind": "operation",
      "operation": {"id": "forge.text.trim", "contract": "1", "implementation": "r1"},
      "config": {}, "input": {"select": {"source": "input", "pointer": "/customer"}}
    },
    {
      "id": "lookup", "kind": "operation",
      "operation": {"id": "reference.customer_lookup", "contract": "1", "implementation": "r1"},
      "config": {}, "input": {"object": {"customer": {"select": {"source": "node", "node": "normalize", "pointer": ""}}}}
    }
  ],
  "edges": [{"from": "normalize", "to": "lookup"}],
  "output": {"object": {
    "customer": {"select": {"source": "node", "node": "normalize", "pointer": ""}},
    "active": {"select": {"source": "node", "node": "lookup", "pointer": "/active"}}
  }},
  "presentation": {"normalize": {"x": 100, "y": 100}, "lookup": {"x": 300, "y": 100}}
